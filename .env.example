# HEALML Enterprise Configuration Template
# Configure your production environment variables below.
# Never commit active secrets or API keys to source control.

# Application Server
PORT=5001
NODE_ENV=production
DATABASE_URL=sqlite:///./data/healml_enterprise.db

# Master Admin Email Configuration for Critical System Alerts
MASTER_ADMIN_ALERT_EMAIL=2269dms@gmail.com

# SMTP Server Configuration (Optional - platform falls back to Master Admin audit ledger if unconfigured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-account@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=alerts@healml-platform.com

# JWT / Session Secrets
SESSION_SECRET=healml-enterprise-production-secret-token-key-change-me-32chars
